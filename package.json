{
  "name": "dsh-sillytavern",
  "version": "0.10.0",
  "description": "SillyTavern Character Card V3 compatibility mode for DeepSeek Harness",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./agent": "./agent.js",
    "./client": "./client.cjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./core/*": "./src/*.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build:events": "node scripts/build-event-explorer.mjs",
    "check:events-bundle": "node scripts/build-event-explorer.mjs --check",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "check": "node scripts/build-event-explorer.mjs --check && node --check host.js && node --check agent.js && node --check client.cjs && node --test --test-isolation=none tests/*.test.js",
    "pack:dry": "pnpm pack --pack-destination .artifacts"
  },
  "files": [
    "host.js",
    "agent.js",
    "client.cjs",
    "src",
    "scripts/build-event-explorer.mjs",
    "preset/*.yml",
    "docs/*.md",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "sillytavern",
    "character-card-v3",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@agnai/web-tokenizers": "^0.1.3",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1",
    "ejs": "3.1.10",
    "tiktoken": "^1.0.22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.1"
  }
}
